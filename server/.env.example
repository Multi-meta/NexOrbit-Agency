# ── MongoDB ────────────────────────────────────────────────────────────────────
# Paste your Atlas connection string here (or use a local Mongo URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/leaddesk?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# ── Admin seed credentials ─────────────────────────────────────────────────────
# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@leaddesk.com
ADMIN_PASSWORD=Admin@1234

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your deployed client URL (no trailing slash). During local dev: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
